# Copy to .env and fill in. Never commit the real .env.

# --- Zerodha Kite Connect ---
# Create an app at https://kite.trade (₹500/month per API key).
KITE_API_KEY=
KITE_API_SECRET=
# Redirect URL registered in the Kite developer console (must match exactly).
KITE_REDIRECT_URL=http://localhost:8000/auth/kite/callback

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0

# --- App ---
# When true, market data comes from a synthetic replay source instead of Kite
# (lets you run the whole stack with no Zerodha account).
USE_MOCK_MARKET_DATA=true
# Secret used to encrypt stored Kite access tokens at rest.
TOKEN_ENCRYPTION_KEY=change-me-32-bytes-minimum-secret
CORS_ORIGINS=http://localhost:3000
